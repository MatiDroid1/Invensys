APP_NAME=Invensys
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Debe ser la URL por la que REALMENTE se entra al sistema. Todo link que
# genera Laravel (correos de recuperación, notificaciones) sale de aquí: si
# queda en localhost, esos links apuntan al computador equivocado.
APP_URL=http://localhost

APP_TIMEZONE=America/Santiago

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# En producción poner en 12 o más. Con menos, las contraseñas se pueden
# romper por fuerza bruta mucho más rápido.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción conviene subirlo a "warning": con "debug" el log crece sin
# parar y termina ocupando el disco.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invensys
DB_USERNAME=root
DB_PASSWORD=

# Alternativa sin servidor de base de datos: SQLite
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Poner en true cuando el sitio se sirva por HTTPS: hace que la cookie de
# sesión no viaje en texto plano.
SESSION_SECURE_COOKIE=false

# Solo si hay un proxy o balanceador delante de Apache. Con valor incorrecto se
# puede falsear la IP real y esquivar el límite de intentos de login.
# TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Invensys no tiene servidor de correo configurado: MAIL_MAILER=log escribe
# los correos en storage/logs/laravel.log en vez de enviarlos. La recuperación
# de contraseña se hace con "php artisan usuario:clave".

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Usuario administrador que crea "php artisan db:seed"
# ---------------------------------------------------------------
# ADMIN_PASSWORD es OBLIGATORIA: sin ella el seeder se detiene en lugar de
# crear una cuenta con una contraseña adivinable.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@invensys.cl
ADMIN_PASSWORD=